// Cloudflare Workers 정적 자산 배포 — ADR-20260913-workers-static-assets, Phase 08 T2.
// 스크립트 없이 dist 만 올린다. 모르는 경로는 index.html 로 응답해 SPA 라우팅·공유 링크 직접 진입이 동작한다.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wks-fe",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
